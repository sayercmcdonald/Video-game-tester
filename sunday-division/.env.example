# Sunday Division — configuration. Copy to .env for local use; set real values as
# environment variables / secrets in production. Never commit a filled-in .env.

NODE_ENV=development
PORT=3000
# Public URL of the site. Must be https:// in production.
BASE_URL=http://localhost:3000
# Where the database and uploaded files live. Mount a persistent, backed-up volume here.
DATA_DIR=./data
# Set to 1 when running behind a reverse proxy / load balancer (most hosts).
TRUST_PROXY=0

# First admin account, created on first start if no users exist (password: 12+ characters).
# Alternatively run: npm run create-admin -- you@example.com "Your Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Shown on the contact page when set.
STUDIO_EMAIL=

# ── Payments (Stripe Checkout) ───────────────────────────────────────────
# Leave empty in development to use the built-in simulated checkout (never real money;
# refused when NODE_ENV=production). Webhook endpoint: {BASE_URL}/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI drafting ──────────────────────────────────────────────────────────
# auto  = Claude when ANTHROPIC_API_KEY is set, rules-based drafting otherwise
# rules = never call a model     claude = always call Claude
AI_PROVIDER=auto
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ── INDEX V3 / FORM (optional; manual mode when empty) ───────────────────
INDEX_V3_API_URL=
INDEX_V3_API_KEY=
FORM_API_URL=
FORM_API_KEY=

# Optional Slack-compatible webhook pinged when a new inquiry arrives (no client details sent).
NOTIFY_WEBHOOK_URL=
