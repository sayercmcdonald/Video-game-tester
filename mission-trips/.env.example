# Copy to .env for local development. Never commit real secrets.
# Each environment (development, staging, production) gets its own values.

APP_ENV=development                      # development | staging | production
APP_URL=http://localhost:3000            # public base URL used in emails and Stripe redirects

DATABASE_URL=postgresql://mission:mission_dev_pw@localhost:5432/mission_dev

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts medical/sensitive participant fields. Losing it makes those fields unreadable.
DATA_ENCRYPTION_KEY=

# Stripe (use test-mode keys outside production). Leave blank to disable online giving.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "connect" = each church connects its own Stripe account (recommended for multiple churches)
# "platform" = all donations go to the single Stripe account above (single-church pilot)
STRIPE_MODE=connect

# Email: "log" writes emails to the outbox table and console only; "resend" sends through Resend.
EMAIL_TRANSPORT=log
EMAIL_FROM="Mission Trips <no-reply@example.org>"
RESEND_API_KEY=

# Where uploaded files are stored. Must NOT be inside /public.
STORAGE_DIR=./storage/uploads

# Shared secret for scheduled job endpoints (deadline reminders, email sending).
CRON_SECRET=
